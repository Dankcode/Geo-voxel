{
  "name": "geo-voxels",
  "version": "0.1.0",
  "description": "Real map data to buildings you can walk into: OpenStreetMap footprints planned room by room (Merrell et al. 2010) into code-checked IFC4 models, game-engine building exports and furnished voxel maps of whole streets — library, CLI, Python pipeline and a Three.js app.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "geo-voxels": "bin/geo-voxels.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "app": "vite --config app/vite.config.js",
    "app:build": "vite build --config app/vite.config.js",
    "engine:sync": "node tools/sync-engine.mjs",
    "engine:check": "node tools/sync-engine.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "3dep",
    "architecture",
    "bim",
    "blender",
    "blendergis",
    "digital-twin",
    "floor-plan",
    "floor-plan-generation",
    "ifc",
    "interior-generation",
    "magicavoxel",
    "map",
    "openstreetmap",
    "procedural",
    "procedural-architecture",
    "procedural-generation",
    "three.js",
    "town-generator",
    "voxel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dankcode/Geo-voxel.git"
  },
  "devDependencies": {
    "leaflet": "^1.9.4",
    "three": "0.169.0",
    "vite": "5.4.10"
  },
  "files": [
    "src",
    "engine",
    "bin",
    "blender",
    "app",
    "examples",
    "docs",
    "skill",
    "tools",
    "README.md",
    "DATA.md",
    "LICENSE"
  ]
}
